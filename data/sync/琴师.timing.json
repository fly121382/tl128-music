  {
   "t": 2.0,
   "s": "版权管理 : 猛犸文化"
  },
  {
   "t": 27.74,
   "s": "「版权所有未经许可请勿翻唱」"
  },
  {
   "t": 34.68,
   "s": "若为此弦声寄入一段情"
  },
  {
   "t": 39.87,
   "s": "北星遥远与之呼应"
  },
  {
   "t": 45.78,
   "s": "再为你取出这把桐木琴"
  },
  {
   "t": 51.03,
   "s": "我又弹到如此用心"
  },
  {
   "t": 56.28,
   "s": "为我解开脚腕枷锁的那个你"
  },
  {
   "t": 61.89,
   "s": "哼着陌生乡音走在宫闱里"
  },
  {
   "t": 67.44,
   "s": "我为君王抚琴时转头看到你"
  },
  {
   "t": 73.35,
   "s": "弦声中深藏初遇的情绪"
  },
  {
   "t": 78.6,
   "s": "月光常常常常到故里"
  },
  {
   "t": 84.51,
   "s": "送回多少离人唏嘘"
  },
  {
   "t": 89.73,
   "s": "咽着你喂给我那勺热粥"
  },
  {
   "t": 95.31,
   "s": "这年月能悄悄的过去"
  },
  {
   "t": 115.62,
   "s": "灯辉摇曳满都城听着雨"
  },
  {
   "t": 120.87,
   "s": "夜风散开几圈涟漪"
  },
  {
   "t": 126.78,
   "s": "你在门外听我练这支曲"
  },
  {
   "t": 131.97,
   "s": "我为你备一件蓑衣"
  },
  {
   "t": 137.19,
   "s": "琴声传到寻常百姓的家里"
  },
  {
   "t": 142.77,
   "s": "有人欢笑有人在哭泣"
  },
  {
   "t": 148.17,
   "s": "情至深处我也落下了泪一滴"
  },
  {
   "t": 154.26,
   "s": "随弦断复了思乡的心绪"
  },
  {
   "t": 159.57,
   "s": "你挽指做蝴蝶从窗框上飞起"
  },
  {
   "t": 165.45,
   "s": "飞过我指尖和眉宇"
  },
  {
   "t": 170.67,
   "s": "呼吸声只因你渐渐宁静"
  },
  {
   "t": 176.22,
   "s": "吹了灯让我拥抱着你"
  },
  {
   "t": 207.03,
   "s": "冬至君王释放我孤身归故地"
  },
  {
   "t": 212.58,
   "s": "我背着琴步步望回宫闱里"
  },
  {
   "t": 218.16,
   "s": "你哼起我们熟知的那半阙曲"
  },
  {
   "t": 224.07,
   "s": "它夹杂着你低沉的抽泣"
  },
  {
   "t": 229.32,
   "s": "路途长长长长至故里"
  },
  {
   "t": 235.23,
   "s": "是人走不完的诗句"
  },
  {
   "t": 240.48,
   "s": "把悲欢谱作曲为你弹起"
  },
  {
   "t": 246.03,
   "s": "才感伤何为身不由己"
  },
  {
   "t": 251.64,
   "s": "月光常常常常照故里"
  },
  {
   "t": 257.49,
   "s": "我是放回池中的鱼"
  },
  {
   "t": 262.65,
   "s": "想着你喂给我那勺热粥"
  },
  {
   "t": 268.32,
   "s": "这回忆就完结在那里"
  },
  {
   "t": 273.93,
   "s": "这年月依然悄悄过去"
  }
 ]
}