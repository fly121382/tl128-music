  {
   "t": 16.13,
   "s": "久未放晴的天空"
  },
  {
   "t": 20.14,
   "s": "依舊留著妳的笑容"
  },
  {
   "t": 24.6,
   "s": "哭過 卻無法掩埋歉疚"
  },
  {
   "t": 31.68,
   "s": "風箏在陰天擱淺"
  },
  {
   "t": 35.64,
   "s": "想念還在等待救援"
  },
  {
   "t": 40.29,
   "s": "我拉著線 複習妳給的溫柔"
  },
  {
   "t": 46.63,
   "s": "曝曬在一旁的寂寞"
  },
  {
   "t": 50.78,
   "s": "笑我給不起承諾"
  },
  {
   "t": 53.91,
   "s": "怎麼會怎麼會 妳竟原諒了我"
  },
  {
   "t": 61.26,
   "s": "我只能永遠讀著對白"
  },
  {
   "t": 65.65,
   "s": "讀著我給妳的傷害"
  },
  {
   "t": 69.57,
   "s": "我原諒不了我"
  },
  {
   "t": 72.32,
   "s": "就請妳當作我已不在"
  },
  {
   "t": 76.85,
   "s": "我睜開雙眼 看著空白"
  },
  {
   "t": 81.33,
   "s": "忘記妳對我的期待"
  },
  {
   "t": 85.22,
   "s": "讀完了依賴 我很快就離開"
  },
