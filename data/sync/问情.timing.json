   "t": 26.59,
   "s": "尚辰："
  },
  {
   "t": 26.84,
   "s": "光阴在穿针将前尘 绣进了掌纹"
  },
  {
   "t": 31.62,
   "s": "千针万线穿梭无声 又无痕"
  },
  {
   "t": 37.84,
   "s": "破漏的记忆想温存 拥紧悲剧传闻"
  },
  {
   "t": 43.62,
   "s": "谁护我天真"
  },
  {
   "t": 49.14,
   "s": "陈亦洺："
  },
  {
   "t": 49.64,
   "s": "并非谁首肯我们才能 叩前世的门"
  },
  {
   "t": 55.92,
   "s": "攒够一瞬妄想永恒 在今生"
  },
  {
   "t": 61.45,
   "s": "可你的眼神多陌生 双唇多冰冷"
  },
  {
   "t": 66.91,
   "s": "我仍想触碰 你的余温"
  },
  {
   "t": 71.44,
   "s": "尚辰："
  },
  {
   "t": 71.94,
   "s": "当思念 一寸一寸滋生"
  },
  {
   "t": 74.7,
   "s": "莫怪春风 一阵一阵转身"
  },
  {
   "t": 78.47,
   "s": "如春草 一寸一寸新生"
  },
  {
   "t": 80.48,
   "s": "是我的情深 一再等"
  },
  {
   "t": 84.26,
   "s": "陈亦洺："
  },
  {
   "t": 84.26,
   "s": "当命运 一句一句探问"
  },
  {
   "t": 86.52,
   "s": "切断缘分 再也无来生"
  },
  {
   "t": 89.79,
   "s": "当爱恨 如潮生 多残忍"
  },
  {
   "t": 94.81,
   "s": "合唱："
  },
  {
   "t": 95.32,
   "s": "这天下 来时哄哄 去时空空"
  },
  {
   "t": 99.34,
   "s": "回首改了面容"
  },
  {
   "t": 101.86,
   "s": "寻不见 前事纷纷 余情深深 深几寸"
  },
  {
   "t": 107.64,
   "s": "若要问 是我愚钝 是我天真"
  },
  {
   "t": 110.91,
   "s": "是我不想懂"
  },
  {
   "t": 113.42,
   "s": "缘分若停顿 轮回何用"
  },
  {
