  {
   "t": 67.6,
   "s": "繋いだその手は温かくて"
  },
  {
   "t": 79.37,
   "s": "優しかった"
  },
  {
   "t": 94.58,
   "s": "あなたはいつもそうやって私を"
  },
  {
   "t": 101.03,
   "s": "怒らせて最後に泣かすんだ"
  },
  {
   "t": 107.45,
   "s": "だけど後になって"
  },
  {
   "t": 110.97,
   "s": "ごめんねっていうその顔"
  },
  {
