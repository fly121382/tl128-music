 "lines": [
  {
   "t": 24.65,
   "s": "嘲笑誰恃美揚威"
  },
  {
   "t": 30.13,
   "s": "沒了心如何相配"
  },
  {
   "t": 34.96,
   "s": "盤鈴聲清脆"
  },
  {
   "t": 38.94,
   "s": "帷幕間燈火幽微"
  },
  {
   "t": 40.5,
   "s": "我和你 最天生一對"
  },
  {
   "t": 47.06,
   "s": "沒了你才算原罪"
  },
  {
   "t": 53.07,
   "s": "沒了心才好相配"
  },
  {
   "t": 57.31,
   "s": "你襤褸我彩繪"
  },
  {
   "t": 59.98,
   "s": "並肩行過山與水"
  },
  {
   "t": 62.65,
   "s": "你憔悴 我替你明媚"
  },
  {
   "t": 68.21,
   "s": "是你吻開筆墨"
  },
  {
   "t": 71.03,
   "s": "染我眼角珠淚"
  },
  {
   "t": 74.01,
   "s": "演離合相遇悲喜為誰"
  },
  {
   "t": 79.47,
   "s": "他們迂迴誤會"
  },
  {
   "t": 82.49,
   "s": "我卻只由你支配"
  },
  {
   "t": 85.09,
   "s": "問世間哪有更完美"
  },
  {
   "t": 90.49,
   "s": "蘭花指捻紅塵似水"
  },
  {
   "t": 96.02,
   "s": "三尺紅台 萬事入歌吹"
  },
  {
   "t": 101.53,
   "s": "唱別久悲不成悲"
  },
  {
   "t": 104.78,
   "s": "十分紅處竟成灰"
  },
  {
   "t": 107.55,
   "s": "願誰記得誰 最好的年歲"
  },
  {
   "t": 136.44,
   "s": "你一牽我舞如飛"
  },
  {
   "t": 141.9,
   "s": "你一引我懂進退"
  },
  {
   "t": 146.49,
   "s": "苦樂都跟隨"
  },
  {
   "t": 149.22,
   "s": "舉手投足不違背"
  },
  {
   "t": 152.18,
   "s": "將謙卑 溫柔成絕對"
  },
  {
   "t": 157.45,
   "s": "你錯我不肯對"
  },
  {
   "t": 160.42,
   "s": "你懵懂我蒙昧"
  },
  {
   "t": 163.11,
   "s": "心火怎甘心揚湯止沸"
  },
  {
   "t": 168.52,
   "s": "你枯我不曾萎"
  },
  {
   "t": 172.09,
   "s": "你倦我也不敢累"
  },
  {
   "t": 174.37,
   "s": "用什麼暖你一千歲"
  },
  {
   "t": 179.75,
   "s": "風雪依稀秋白髮尾"
  },
  {
   "t": 185.14,
   "s": "燈火葳蕤 揉皺你眼眉"
